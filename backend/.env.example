DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/dostock

# 무료 기본: NEWS_PROVIDER=yfinance, AI_PROVIDER=rules (키 없어도 동작)
NEWS_PROVIDER=auto
AI_PROVIDER=auto
# 외국어 뉴스/본문 한국어 번역 (무료, deep-translator)
ENABLE_TRANSLATION=true

# 유료(선택): Serper 뉴스
SERPER_API_KEY=

# 유료(선택): Anthropic AI — 실패 시 자동으로 rules 폴백
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# 무료(선택): 로컬 Ollama — ollama.com 설치 후 AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
# 프로덕션: 프론트 URL(쉼표로 여러 개). 예: https://my-app.vercel.app
CORS_ORIGINS=
